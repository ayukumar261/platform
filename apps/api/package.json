{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:types": "kysely-codegen --env-file ../../.env --camel-case --exclude-pattern atlas_schema_revisions --out-file src/clients/database.types.ts && prettier --write src/clients/database.types.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "kysely": "0.29.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "typescript": "7.0.2"
  }
}
