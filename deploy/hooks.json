[
  {
    "id": "deploy",
    "execute-command": "/opt/platform/deploy/deploy.sh",
    "command-working-directory": "/opt/platform",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv `PLATFORM_HOOK_SECRET` }}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
